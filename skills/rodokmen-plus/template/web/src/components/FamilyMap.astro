---
// Mapa míst, kde žili předci (Leaflet + OpenStreetMap); jedna tečka za (místo, rod).
import 'leaflet/dist/leaflet.css';
import site from '../data/site.json';
import { lineByK, people, href, houseList, houseTitle } from '../lib/data.js';
const { height = '70vh', compact = false, showHouses = true } = Astro.props;
const ROOT_COLOR = '#8a6d52';
const lines = Object.fromEntries(Object.values(lineByK).map((l) => [l.k, { name: l.name, color: l.color, slug: l.slug }]));
lines[0] = { name: 'rodiče a prarodiče', color: ROOT_COLOR, slug: null };
const names = {};
for (const pl of site.places) for (const l of pl.lines) for (const s of l.people) names[s] = [people[s].name, people[s].years, href.person(s)];
const houses = showHouses ? houseList.filter((h) => h.lat != null).map((h) => ({
  title: houseTitle(h), url: href.house(h.slug), lat: h.lat, lon: h.lon, approx: h.approx, center: h.center, obec: h.obec, done: h.processed,
  who: h.ancestors.map((s) => [people[s].name, people[s].years, href.person(s)]),
})) : [];
const payload = JSON.stringify({ places: site.places, lines, names, compact, houses });
---
<div class="fmap" style={`height:${height}`} data-map={payload}></div>
{!compact && (
  <div class="fmap-legend">
    {Object.entries(lines).filter(([k]) => k !== '0').map(([k, l]) => (
      <label><input type="checkbox" data-line={k} checked /><span class="dot" style={`background:${l.color}`}></span>{l.name}</label>
    ))}
    <label><input type="checkbox" data-line="0" checked /><span class="dot" style={`background:${ROOT_COLOR}`}></span>rodiče a prarodiče</label>
    {showHouses && <label><input type="checkbox" data-line="domy" checked /><span class="hsq"></span>domy rodiny</label>}
  </div>
)}

<script>
  import L from 'leaflet';
  // jména pocházejí z dat (i z importovaného GEDCOM) – do HTML popupu a tooltipu jen jako text
  const esc = (v: unknown) => String(v ?? '').replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);

  for (const el of document.querySelectorAll<HTMLElement>('.fmap')) {
    const { places, lines, names, compact, houses } = JSON.parse(el.dataset.map!);
    // Gesture handling: page scroll stays page scroll. Zoom with Ctrl/⌘ + wheel (or trackpad pinch),
    // on touch devices move the map with two fingers; otherwise show a short hint.
    const touch = window.matchMedia('(pointer: coarse)').matches;
    const map = L.map(el, { scrollWheelZoom: false, dragging: !touch, tap: false });
    const hint = L.DomUtil.create('div', 'fmap-hint', el);
    hint.textContent = touch ? 'Mapu posunete dvěma prsty' : `Pro přiblížení mapy držte ${/Mac|iPhone|iPad/.test(navigator.platform) ? '⌘' : 'Ctrl'} a točte kolečkem`;
    let hintTimer = 0;
    const showHint = () => { hint.classList.add('on'); clearTimeout(hintTimer); hintTimer = window.setTimeout(() => hint.classList.remove('on'), 1200); };
    el.addEventListener('wheel', (e) => {
      if (e.ctrlKey || e.metaKey) {
        e.preventDefault();
        const p = map.mouseEventToContainerPoint(e as unknown as MouseEvent);
        map.setZoomAround(p, map.getZoom() + (e.deltaY < 0 ? 1 : -1));
      } else showHint();
    }, { passive: false });
    if (touch) {
      el.addEventListener('touchstart', (e) => { if (e.touches.length > 1) map.dragging.enable(); else map.dragging.disable(); }, { passive: true });
      el.addEventListener('touchmove', (e) => { if (e.touches.length === 1) showHint(); }, { passive: true });
      el.addEventListener('touchend', () => map.dragging.disable(), { passive: true });
    }
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);
    const groups: Record<string, L.LayerGroup> = {};
    const bounds: L.LatLngExpression[] = [];
    const spread: (() => void)[] = [];
    for (const pl of places) {
      const n = pl.lines.length;
      pl.lines.forEach((ln: { k: number; people: string[] }, i: number) => {
        const a = (2 * Math.PI * i) / Math.max(n, 1);
        // rodové tečky kolem obce: posun v pixelech (ne ve stupních), aby při každém přiblížení zůstaly u obce
        const px = n > 1 ? (compact ? 9 : 13) : 0;
        const at = (): L.LatLng => {
          const c = map.project([pl.lat, pl.lon], map.getZoom());
          return map.unproject(c.add([px * Math.sin(a), -px * Math.cos(a)]), map.getZoom());
        };
        const pos: L.LatLngExpression = [pl.lat, pl.lon];
        const line = lines[ln.k] ?? lines[0];
        const count = ln.people.length;
        const marker = L.circleMarker(pos, {
          radius: compact ? 5 + Math.sqrt(count) * 1.6 : 7 + Math.sqrt(count) * 2.2,
          color: '#3b2e22',
          weight: 1,
          fillColor: line.color,
          fillOpacity: pl.hypothesis ? 0.35 : 0.9,
          dashArray: pl.hypothesis ? '3 3' : undefined,
        });
        const who = ln.people
          .map((s) => `<a href="${esc(names[s][2])}">${esc(names[s][0])}</a>${names[s][1] ? ` <span class="y">${esc(names[s][1])}</span>` : ''}`)
          .join('<br>');
        const head = line.slug ? `<a href="/rod/${esc(line.slug)}/">${esc(line.name)}</a>` : esc(line.name);
        marker.bindPopup(
          `<strong><a href="/misto/${esc(pl.slug)}/">${esc(pl.name)}</a></strong>${pl.years ? ` <span class="y">${pl.years[0]}–${pl.years[1]}</span>` : ''}<br>` +
            `<span class="pl" style="--c:${esc(line.color)}">${head}</span><br>` +
            (pl.hypothesis ? 'hypotéza – vazba zatím neprokázaná' : who),
          { maxHeight: 260 }
        );
        marker.bindTooltip(`${esc(pl.name)} · ${esc(line.name)}${count ? ` (${count})` : ''}`);
        (groups[ln.k] ??= L.layerGroup().addTo(map)).addLayer(marker);
        if (px) spread.push(() => marker.setLatLng(at()));
        bounds.push(pos);
      });
    }
    // domy rodiny: čtvereček; bez přesné polohy jen kolem středu obce (čárkovaný okraj)
    const perVillage: Record<string, number> = {};
    for (const h of houses) {
      let pos: L.LatLngExpression = [h.lat, h.lon];
      if (h.center) {   // poloha neznámá: domy téže obce těsně kolem středu, aby se nepřekrývaly
        const i = (perVillage[h.obec] = (perVillage[h.obec] ?? 0) + 1);
        const a = i * 2.39996, d = 0.0004 * Math.sqrt(i);
        pos = [h.lat + d * Math.cos(a), h.lon + (d * Math.sin(a)) / Math.cos((h.lat * Math.PI) / 180)];
      }
      const icon = L.divIcon({ className: `hmark${h.done ? ' done' : ''}${h.approx ? ' approx' : ''}`, iconSize: h.done ? [16, 16] : [11, 11] });
      const who = h.who.map((w: string[]) => `<a href="${esc(w[2])}">${esc(w[0])}</a>${w[1] ? ` <span class="y">${esc(w[1])}</span>` : ''}`).join('<br>');
      const m = L.marker(pos, { icon, zIndexOffset: h.done ? 1000 : 500 })
        .bindPopup(`<strong><a href="${esc(h.url)}">${esc(h.title)}</a></strong><br>` +
          (h.done ? 'dějiny domu zpracované<br>' : '') + (h.center ? '<span class="y">poloha domu neznámá – bod je jen u středu obce</span><br>' : h.approx ? '<span class="y">poloha podle dnešního čp. – nejistá (možné přečíslování)</span><br>' : '') + who, { maxHeight: 260 })
        .bindTooltip(esc(h.title));
      (groups.domy ??= L.layerGroup().addTo(map)).addLayer(m);
    }
    if (bounds.length) map.fitBounds(L.latLngBounds(bounds), { padding: [20, 20], maxZoom: 11 });
    else map.setView([49.8, 15.5], 7);
    const respread = () => spread.forEach((f) => f());
    map.on('zoomend', respread);
    map.whenReady(respread);
    el.parentElement?.querySelectorAll<HTMLInputElement>('.fmap-legend input').forEach((cb) =>
      cb.addEventListener('change', () => {
        const g = groups[cb.dataset.line!];
        if (g) cb.checked ? g.addTo(map) : g.remove();
      })
    );
  }
</script>

<style is:global>
  .fmap { width: 100%; border: 1px solid var(--line); border-radius: 12px; z-index: 0; }
  .fmap-hint { position: absolute; inset: 0; z-index: 1001; display: grid; place-items: center; background: rgba(0, 0, 0, 0.45); color: #fff;
    font: 600 1.05rem system-ui, sans-serif; text-align: center; padding: 1rem; pointer-events: none; opacity: 0; transition: opacity 0.25s; }
  .fmap-hint.on { opacity: 1; }
  .fmap-legend { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; margin: 0.6rem 0; font-size: 0.9rem; }
  .fmap-legend label { display: inline-flex; align-items: center; gap: 0.35rem; cursor: pointer; }
  .fmap-legend .dot { width: 0.8rem; height: 0.8rem; border-radius: 50%; border: 1px solid #3b2e22; }
  .hmark { background: #fff; border: 2px solid #3b2e22; border-radius: 3px; }
  .hmark.done { background: var(--accent); border-color: #3b2e22; }
  .hmark.approx { border-style: dashed; opacity: 0.85; }
  .fmap-legend .hsq { width: 0.75rem; height: 0.75rem; border: 2px solid #3b2e22; border-radius: 2px; background: #fff; }
  .leaflet-popup-content { font-size: 0.85rem; line-height: 1.4; }
  .leaflet-popup-content .y { color: #6e6153; }
  .leaflet-popup-content .pl { border-left: 4px solid var(--c); padding-left: 0.35rem; }
</style>
