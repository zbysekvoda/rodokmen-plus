---
// Galerie příběhu: jen dokumenty, které k příběhu patří (export: docs[].stories). Bez dokumentů nic nevykreslí.
import { docs } from '../lib/data.js';
// story: 'pribehy' | 'pribeh-domu' | slug z web.json „pribehy“
interface Props { story: string }
const own = docs.filter((d) => (d.stories ?? []).includes(Astro.props.story));
---
{own.length > 0 && (
  <>
    <h2>Rodinné dokumenty a fotografie</h2>
    <div class="docs">
      {own.map((d) => (
        <figure><a href={`/img/${d.img}.jpg`} target="_blank" rel="noopener"><img src={`/img/${d.img}.jpg`} alt={d.caption} loading="lazy" /></a><figcaption>{d.caption}</figcaption></figure>
      ))}
    </div>
  </>
)}
