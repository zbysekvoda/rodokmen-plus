---
// Společná kostra pohledů s vazbami v čase (Osa s vazbami, Vějíř v čase, Řeka času): lišta, legenda, plátno.
// Rozložení počítá prohlížeč (lib/vazby.js) kolem osoby ?o=<id> (výchozí první kořen z KORENY), zoom lib/panzoom.js.
import Base from '../layouts/Base.astro';
import ViewSwitch from './ViewSwitch.astro';
import { people, families, roots } from '../lib/data.js';
import { compact } from '../lib/vazby.js';
const { view, title, hint } = Astro.props;
const data = JSON.stringify({ ...compact(people, families), root: roots[0].id, roots });
const names = Object.values(people).map((p) => [p.slug, `${p.name}${p.birth?.y ? ` (${p.birth.y})` : ''}`]).sort((a, b) => a[1].localeCompare(b[1], 'cs'));
---
<Base title={title} full>
  <div class="fan-bar vz-bar" data-view={view}>
    <ViewSwitch current={{ osa: 'osa', vejir: 'vejir-cas', reka: 'reka' }[view]} />
    <strong>{title}</strong>
    <form class="vz-pick" autocomplete="off">
      <input list="vz-names" placeholder="Kolem osoby…" aria-label="Zobrazit kolem osoby" />
      <datalist id="vz-names">{names.map(([, n]) => <option value={n} />)}</datalist>
      <button type="submit">Zobrazit</button>
    </form>
    {view === 'reka' && (
      <label class="small">Generací
        <select class="vz-gens" aria-label="Počet generací">{[3, 4, 5, 6].map((g) => <option value={g}>{g}</option>)}</select>
      </label>
    )}
    <span class="fan-btns">
      <button type="button" data-pz="in" aria-label="Přiblížit">+</button>
      <button type="button" data-pz="out" aria-label="Oddálit">−</button>
      <button type="button" data-pz="reset">Celé</button>
    </span>
    <span class="small muted fan-hint">{hint}</span>
  </div>
  <div class="vz-legend small">
    <span class="vz-who"></span>
    <span><i class="lg lg-doc"></i>sňatek doložen datem</span>
    <span><i class="lg lg-year"></i>jen rok</span>
    <span><i class="lg lg-est"></i>odhad (rok před 1. dítětem)</span>
    <span><i class="lg lg-m"></i>muž</span><span><i class="lg lg-f"></i>žena</span>
    <span><i class="lg lg-dot"></i>rok narození dopočten</span>
    <span class="vz-unplaced"></span>
  </div>
  <div class="fan-stage vz-stage" data-view={view}><noscript><p class="pad">Pohled potřebuje JavaScript.</p></noscript></div>
  <script type="application/json" id="vz-data" set:html={data} />

  <script>
    import { expand, layoutOsa, layoutVejir, layoutReka, bindHighlight } from '../lib/vazby.js';
    import { panZoom, bindButtons } from '../lib/panzoom.js';
    const raw = JSON.parse(document.getElementById('vz-data')!.textContent!);
    const db = expand(raw);
    const bar = document.querySelector<HTMLElement>('.vz-bar')!;
    const stage = document.querySelector<HTMLElement>('.vz-stage')!;
    const view = stage.dataset.view!;
    const qs = new URLSearchParams(location.search);
    const id = db.people[qs.get('o') ?? ''] ? qs.get('o')! : raw.root;
    const gens = Math.min(6, Math.max(3, Number(qs.get('g')) || 4));
    const res = view === 'osa' ? layoutOsa(db, id) : view === 'vejir' ? layoutVejir(db, id) : layoutReka(db, id, { gens });
    stage.innerHTML = res.svg;
    const svg = stage.querySelector('svg')!;
    const p = db.people[id];
    const who = document.querySelector('.vz-who')!;
    who.innerHTML = `<b>${p.n.replace(/</g, '&lt;')}</b> · ${res.count} osob`;
    document.querySelector('.vz-unplaced')!.textContent = `nedá se umístit v čase: ${res.unplaced}`;
    // úroveň detailu podle toho, kolik px na obrazovce má řádek / sloupec (text se tak nepřekrývá)
    const api = panZoom(stage, svg, {
      onChange: ({ z, u }) => {
        const px = res.rowPx / u;
        svg.dataset.lod = px >= 19 ? 'near' : px >= 11 ? 'mid' : 'far';
        svg.classList.toggle('vz-near', z >= 2.2);
      },
    });
    if (res.start) api.focus(res.start.x, res.start.y, res.start.w, res.start.h);
    bindButtons(bar, api);
    bindHighlight(svg);
    // výběr osoby
    const ids = Object.entries(db.people).map(([k, v]) => ({ k, label: `${v.n}${v.b ? ` (${v.b})` : ''}` }));
    bar.querySelector('.vz-pick')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const v = (e.currentTarget as HTMLFormElement).querySelector('input')!.value.trim().toLowerCase();
      const hit = ids.find((x) => x.label.toLowerCase() === v) ?? ids.find((x) => x.label.toLowerCase().includes(v));
      if (hit) { qs.set('o', hit.k); location.search = qs.toString(); }
    });
    const g = bar.querySelector<HTMLSelectElement>('.vz-gens');
    if (g) { g.value = String(gens); g.addEventListener('change', () => { qs.set('g', g.value); location.search = qs.toString(); }); }
  </script>
</Base>

<style is:global>
  .vz-legend { display: flex; flex-wrap: wrap; gap: 0.3rem 1rem; padding: 0.35rem 1rem; border-bottom: 1px solid var(--line); background: var(--paper); color: var(--muted); }
  .vz-legend .lg { display: inline-block; width: 22px; height: 0; vertical-align: middle; margin-right: 0.35rem; border-top: 2px solid var(--vz-mar); }
  .vz-legend .lg-year { border-top-style: dashed; }
  .vz-legend .lg-est { border-top-style: dotted; }
  .vz-legend .lg-m { border-top: 4px solid var(--vz-m); }
  .vz-legend .lg-f { border-top: 4px solid var(--vz-f); }
  .vz-legend .lg-dot { width: 10px; height: 10px; border: 2px solid var(--vz-mar); border-radius: 50%; background: var(--vz-est); }
  .vz-unplaced { font-weight: 600; color: var(--text); }
  .vz-stage { height: calc(100vh - 140px); height: calc(100dvh - 140px); overscroll-behavior: contain; }
  @media (max-width: 720px) { .vz-stage { height: calc(100dvh - 210px); } .vz-legend { font-size: 0.75rem; gap: 0.2rem 0.6rem; } }
  :root { --vz-m: #2f5d8a; --vz-f: #b5562f; --vz-mar: #5b5348; --vz-est: #e8e1d4; --vz-grid: #e4ddd0; }
  :root[data-theme='dark'] { --vz-m: #7fa8d4; --vz-f: #e39a78; --vz-mar: #c9c0b2; --vz-est: #3a352e; --vz-grid: #2e333c; }
  .vz-stage svg { --u: 1; font-family: var(--sans); }
  .vz-stage svg text { fill: var(--text); }
  .vz-stage .vz-n { font: 600 max(12px, calc(var(--u) * 11px)) var(--serif); }
  .vz-stage .vz-n.sib { font-weight: 400; }
  .vz-stage .vz-n.vz-small { font-size: max(10px, calc(var(--u) * 10px)); }
  .vz-stage .vz-s, .vz-stage .vz-m { font-size: max(10px, calc(var(--u) * 9.5px)); fill: var(--muted); }
  .vz-stage .vz-m { font-weight: 500; fill: var(--text); }
  .vz-stage .vz-ax { font-size: max(11px, calc(var(--u) * 10px)); fill: var(--muted); }
  .vz-stage .vz-ax.b { font-weight: 600; }
  .vz-stage .vz-grid line, .vz-stage .vz-grid circle { stroke: var(--vz-grid); fill: none; }
  .vz-stage .vz-grid .g100 { stroke: var(--rule-strong); }
  .vz-stage .vz-grid .vz-now { fill: var(--vz-mar); stroke: none; }
  .vz-stage .vz-today { stroke: var(--vz-mar); stroke-width: 1.5; }
  .vz-stage .vz-p { cursor: pointer; }
  .vz-stage .vz-p.sx-m { color: var(--vz-m); }
  .vz-stage .vz-p.sx-f { color: var(--vz-f); }
  .vz-stage .vz-lifebar { fill: currentColor; opacity: 0.85; }
  .vz-stage .vz-lifebar.est { opacity: 0.55; }
  .vz-stage .vz-lifebar.open { mask: none; opacity: 0.4; }
  .vz-stage .vz-dot { fill: var(--paper); stroke: currentColor; stroke-width: 2.2; }
  .vz-stage .vz-dot.est { fill: var(--vz-est); }
  .vz-stage .vz-mar line, .vz-stage .vz-mar path { stroke: var(--vz-mar); stroke-width: 1.6; fill: none; }
  .vz-stage .vz-mar circle { fill: var(--vz-mar); }
  .vz-stage .vz-mar .vz-kid { stroke-width: 1; opacity: 0.7; }
  .vz-stage .vz-mar .vz-spoke { stroke-width: 0.8; opacity: 0.35; }
  .vz-stage .vz-mar .vz-couple { stroke-width: 5; stroke-linecap: round; opacity: 0.45; }
  .vz-stage .vz-mar .vz-node, .vz-stage .vz-mar2 .vz-node { fill: var(--bg); stroke: var(--vz-mar); stroke-width: 2; }
  .vz-stage .vz-mar.q-doc .vz-node, .vz-stage .vz-mar2.q-doc .vz-node { fill: var(--vz-mar); }
  .vz-stage .vz-mar2 .vz-fork { stroke: var(--vz-mar); stroke-width: 1.6; fill: none; stroke-dasharray: 2 2; }
  .vz-stage .vz-st { color: var(--vz-m); }
  .vz-stage .vz-st.sx-f { color: var(--vz-f); }
  .vz-stage .vz-st path { stroke: currentColor; stroke-width: 2.2; fill: none; }
  .vz-stage .vz-st .vz-life.open { stroke-dasharray: 3 4; opacity: 0.6; }
  .vz-stage .vz-st.sib path { stroke-width: 1.6; }
  /* úroveň detailu: oddáleno jen tvary, popisky se ukážou po přiblížení (a v bublině při najetí) */
  .vz-stage svg[data-lod='far'] .vz-people text, .vz-stage svg[data-lod='mid'] .vz-people .vz-s { display: none; }
  .vz-stage svg[data-lod='far'] .vz-mar text, .vz-stage svg[data-lod='far'] .vz-mar2 text { display: none; }
  /* vějíř: jména od 6. generace až po přiblížení */
  .vz-stage .vz-detail { display: none; }
  .vz-stage svg.vz-near .vz-detail { display: inline; }
  /* zvýraznění vazeb */
  .vz-stage svg.vz-hl .vz-p, .vz-stage svg.vz-hl .vz-mar, .vz-stage svg.vz-hl .vz-st { opacity: 0.25; transition: opacity 0.15s; }
  .vz-stage svg.vz-hl .on { opacity: 1 !important; }
  .vz-stage svg.vz-hl .vz-mar.on line, .vz-stage svg.vz-hl .vz-mar.on path { stroke-width: 2.6; }
</style>
