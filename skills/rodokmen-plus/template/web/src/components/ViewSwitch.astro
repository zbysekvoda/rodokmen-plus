---
// Přepínač pohledů na předky. Seznam pohledů je jen tady: [klíč, popisek, adresa, schovaný v „Další pohledy“].
// slug = osoba, na kterou se pohled zaměří; current = klíč aktivního pohledu (aria-current i u schovaných).
// Osa s vazbami (/osa-vazby/) patří pod Časovou osu – viz components/OsaSwitch.astro.
const { slug = null, current = null } = Astro.props;
const q = slug ? `?o=${slug}` : '';
const views = [
  ['strom', 'Generace', `/strom/${slug ? '#' + slug : ''}`],
  ['pasy', 'Pásy rodů', '/pasy/'],
  ['vejir', 'Vějíř', `/vejir/${q}`],
  ['cely', 'Celý strom', `/strom-cely/${q}`],
  ['predci', 'Seznam předků', '/predci/'],
  ['vejir-cas', 'Vějíř v čase', `/vejir-cas/${q}`, true],
  ['reka', 'Řeka času', `/reka/${q}`, true],
];
const aria = (k) => (k === current ? 'page' : undefined);
const main = views.filter((v) => !v[3]);
const more = views.filter((v) => v[3]);
const moreActive = more.some(([k]) => k === current);
---
<nav class="view-switch-wrap" aria-label="Pohled">
  <span class="view-switch">{main.map(([k, label, url]) => <a href={url} aria-current={aria(k)}>{label}</a>)}</span>
  {more.length > 0 && (
    <details class="view-more" data-active={moreActive ? '' : undefined}>
      <summary>Další pohledy ▾</summary>
      <div class="view-more-menu">{more.map(([k, label, url]) => <a href={url} aria-current={aria(k)}>{label}</a>)}</div>
    </details>
  )}
</nav>
