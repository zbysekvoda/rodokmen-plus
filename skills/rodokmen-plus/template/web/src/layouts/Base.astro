---
import '../styles/global.css';
import { config, lines } from '../lib/data.js';
const siteName = config.nazev || 'Rodokmen';
const { title, description = config.popis || siteName, wide = false, wider = false, full = false } = Astro.props;
const path = Astro.url.pathname;
// nahoře hlavní cesty; krátké příběhy (dřív zajímavosti) vedou přes rozcestník /pribehy/, mapa přes stránku Domy; Osobnosti a V číslech mají vlastní položku; Vějíř / Předci jsou přepínač pohledů u stromu, badatelské stránky v patičce
// web.json „menu_skryt“: ["/osobnosti/"] položku z menu vynechá (stránka zůstane dostupná adresou)
const hidden = config.menu_skryt ?? [];
const top = [
  ['/pribehy/', 'Příběhy', ['/pribeh-rodu/', '/pribeh-domu/', '/pribeh/', '/zajimavosti/']], ['/osobnosti/', 'Osobnosti', []],
  ['/rody/', 'Rody', ['/rod/', '/rodina/']], ['/domy/', 'Domy', ['/dum/', '/mapa/']], ['/strom/', 'Strom', ['/vejir/', '/predci/', '/pasy/', '/strom-cely/', '/osa-vazby/', '/vejir-cas/', '/reka/']],
  ['/osa/', 'Časová osa', []], ['/statistiky/', 'V číslech', []], ['/hledat/', 'Hledat', []],
]].filter(([u]) => u === '/pribehy/' || !hidden.includes(u));
const mobileTabs = [top[0][0], '/strom/', '/domy/', '/hledat/'];
const research = [['/zapisy/', 'Zápisy'], ['/denik/', 'Deník'], ['/hledame/', 'Co hledáme']];
const lineVars = Object.values(lines).map((l) => `--line-${l.slug}:${l.color}`).join(';');
const current = (url, also = []) => ([url, ...also].some((u) => path.startsWith(u)) ? 'page' : undefined);
---
<!doctype html>
<html lang="cs" style={lineVars}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{title ? `${title} · ${siteName}` : siteName}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='15' fill='%235B4A3A'/><path d='M16 8v16M9 14l7-6 7 6' stroke='%23FBF8F2' stroke-width='2.5' fill='none'/></svg>" />
  </head>
  <body>
    <script is:inline>try{if(localStorage.getItem('theme')==='dark')document.documentElement.dataset.theme='dark'}catch(e){}</script>
    <div class="shell">
    <aside class="rail">
      <a class="brand" href="/">{siteName}{config.podtitul && <small>{config.podtitul}</small>}</a>
      <a class="rail-search" href="/hledat/">Hledat <kbd>/</kbd></a>
      <nav aria-label="Hlavní">
        {[['/', 'Úvod', []], ...top.filter(([u]) => u !== '/hledat/')].map(([url, label, also]) => <a href={url} aria-current={url === '/' ? (path === '/' ? 'page' : undefined) : current(url, also)}>{label}</a>)}
      </nav>
      <div class="rail-label">Pro badatele</div>
      <nav aria-label="Pro badatele">
        {research.map(([url, label]) => <a href={url} aria-current={current(url)}>{label}</a>)}
      </nav>
      <div class="rail-foot"><button class="theme-btn" type="button" data-theme-toggle>Tmavý režim</button></div>
    </aside>
    <div class="shell-main">
    <header class="topbar">
      <a class="brand" href="/">{siteName}</a>
      <div class="topbar-actions"><a href="/hledat/">Hledat</a></div>
    </header>
    <main class={full ? 'full' : wider ? 'wider' : wide ? 'wide' : ''} data-pagefind-body>
      <slot />
    </main>
    {!full && <footer class="site-footer">
      {config.zapati || 'Dohledáno v digitalizovaných matrikách'} · rodinný web, neveřejný
    </footer>}
    </div>
    </div>
    <div class="more-sheet" id="more-sheet">
      {[...top.filter(([u]) => !mobileTabs.includes(u)), ...research].map(([url, label]) => <a href={url} aria-current={current(url)}>{label}</a>)}
      <p><button class="theme-btn" type="button" data-theme-toggle>Tmavý režim</button></p>
    </div>
    <nav class="tabbar" aria-label="Hlavní (mobil)">
      <a href="/" aria-current={path === '/' ? 'page' : undefined}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 11l8-7 8 7v9H4z"/></svg>Úvod</a>
      <a href={top[0][0]} aria-current={current(top[0][0], top[0][2])}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 4h10l4 4v12H5z"/></svg>Příběhy</a>
      <a href="/strom/" aria-current={current('/strom/', ['/vejir/', '/predci/', '/pasy/', '/strom-cely/', '/osa-vazby/', '/vejir-cas/', '/reka/'])}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 20V10M12 10l-6-5M12 10l6-5"/></svg>Strom</a>
      <a href="/domy/" aria-current={current('/domy/', ['/dum/'])}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 20V9l8-5 8 5v11zM10 20v-6h4v6"/></svg>Domy</a>
      <button type="button" aria-expanded="false" aria-controls="more-sheet" data-more><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>Více</button>
    </nav>
    <script>
      const root = document.documentElement;
      const toggles = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
      const label = () => toggles.forEach((b) => (b.textContent = root.dataset.theme === 'dark' ? 'Světlý režim' : 'Tmavý režim'));
      label();
      toggles.forEach((b) => b.addEventListener('click', () => {
        const dark = root.dataset.theme !== 'dark';
        if (dark) root.dataset.theme = 'dark'; else delete root.dataset.theme;
        try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch {}
        label();
      }));
      const more = document.querySelector<HTMLButtonElement>('[data-more]');
      more?.addEventListener('click', () => more.setAttribute('aria-expanded', String(document.body.classList.toggle('more-open'))));
      document.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement;
        if (e.key === '/' && !e.metaKey && !e.ctrlKey && !/INPUT|TEXTAREA|SELECT/.test(t.tagName) && !t.isContentEditable) {
          const box = document.querySelector<HTMLInputElement>('main input[type=search], main input[type=text]');
          if (box) { e.preventDefault(); box.focus(); } else { e.preventDefault(); location.href = '/hledat/'; }
        }
      });
    </script>
  </body>
</html>
