---
import Base from '../layouts/Base.astro';
import PersonLink from '../components/PersonLink.astro';
import { houseList, href, houseTitle } from '../lib/data.js';
const done = houseList.filter((h) => h.processed);
const rest = houseList.filter((h) => !h.processed);
const byVillage = Object.entries(rest.reduce((a, h) => ((a[h.obec] ??= []).push(h), a), {})).sort(([a], [b]) => a.localeCompare(b, 'cs'));
---
<Base title="Domy" wide>
  <h1>Domy, kde žili naši předci</h1>
  <p class="lead"><a href="/mapa/">Mapa míst →</a></p>
  <p class="lead">{houseList.length} domů ve {byVillage.length + (done.length ? 1 : 0)} obcích. U {done.length === 1 ? 'jednoho' : done.length} máme zpracované celé dějiny – kdo dům držel, kdo v něm bydlel, staré mapy. U ostatních zatím jen to, kdo z rodiny v nich žil.</p>

  {done.length > 0 && (
    <>
      <h2>Dějiny zpracované</h2>
      <div class="house-list">
        {done.map((h) => (
          <a class="card card-link" href={href.house(h.slug)}>
            <h3>{houseTitle(h)}</h3>
            <p class="small">{h.owners.length} držitelů, {h.people.length} obyvatel, {h.events.length} událostí</p>
            <p class="small muted">Předkové: {h.ancestors.length}</p>
          </a>
        ))}
      </div>
    </>
  )}

  <h2>Zatím nezpracované</h2>
  {byVillage.map(([obec, list]) => (
    <>
      <h3>{obec}</h3>
      <ul>
        {list.map((h) => (
          <li><a href={href.house(h.slug)}>čp. {h.cp}</a> – {h.ancestors.map((s, i) => <>{i > 0 && ', '}<PersonLink slug={s} /></>)}</li>
        ))}
      </ul>
    </>
  ))}
</Base>
