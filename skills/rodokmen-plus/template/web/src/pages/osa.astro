---
import Base from '../layouts/Base.astro';
import { people, lines } from '../lib/data.js';
import { layout, bar, SORTS, NOW } from '../lib/osa.js';
const site = await import('../data/site.json');
const milestones = site.default.milestones ?? [];
const lineList = Object.values(lines);
const lineOf = (p) => (p.lineSlug && lines[p.lineSlug]) || null;
const rows = Object.values(people).filter((p) => p.birth && (p.death || p.alive)).map((p) => {
  const l = lineOf(p);
  return { id: p.slug, name: p.name, years: p.years, b: p.birth, d: p.death, alive: p.alive, gen: p.gen, place: p.place,
    line: l?.slug ?? 'ostatni', lineName: l ? `Rod ${l.name}` : 'Příbuzní mimo rody', lineOrder: l ? lineList.indexOf(l) : 99 };
});
const missing = Object.keys(people).length - rows.length;
const from = Math.floor(Math.min(...rows.map((r) => r.b.lo)) / 10) * 10 - 10;
const L = layout(rows, { from });
const decades = []; for (let y = Math.ceil(from / 50) * 50; y <= NOW; y += 50) decades.push(y);
const evidence = { doc: 'rok doložen', est: 'odhad', calc: 'dopočteno z příbuzných', unk: 'neznámé' };
const title = (r) => `${r.name} ${r.years || ''} – narození: ${evidence[r.b.q]}${r.alive ? ', žije' : `, úmrtí: ${evidence[r.d.q]}`}`;
---
<Base title="Časová osa" wider>
  <h1>Časová osa</h1>
  <p class="lead">Každý člověk je jeden pruh od narození do úmrtí, v barvě svého rodu. Rozostřený konec znamená, že rok známe jen přibližně; pruh, který se rozplývá, znamená, že úmrtí zatím neznáme. V pozadí jsou velké dějinné události, které naše předky zasáhly.</p>
  <div class="osa-ctrl" data-osa-ctrl>
    <label>Řadit <select name="sort">{Object.entries(SORTS).map(([k, v]) => <option value={k}>{v}</option>)}</select></label>
    <fieldset class="osa-lines"><legend class="sr-only">Rody</legend>
      {lineList.map((l) => <label class="chip"><input type="checkbox" name="line" value={l.slug} checked /><span class="dot" style={`background:var(--line-${l.slug})`}></span>{l.name}</label>)}
      <label class="chip"><input type="checkbox" name="line" value="ostatni" checked /><span class="dot" style="background:var(--line-ostatni)"></span>ostatní</label>
    </fieldset>
    <span class="osa-zoom"><button type="button" data-zoom="-1" aria-label="Oddálit">−</button><button type="button" data-zoom="1" aria-label="Přiblížit">+</button></span>
  </div>
  <div class="osa-scroll" data-osa-scroll>
    <svg class="osa" data-osa data-from={from} width={L.width} height={L.height} viewBox={`0 0 ${L.width} ${L.height}`} role="img" aria-label="Časová osa života všech osob v rodokmenu">
      <defs>
        <linearGradient id="osa-in"><stop offset="0" stop-color="#fff" stop-opacity="0" /><stop offset="1" stop-color="#fff" stop-opacity="1" /></linearGradient>
        <linearGradient id="osa-out"><stop offset="0" stop-color="#fff" stop-opacity="1" /><stop offset="1" stop-color="#fff" stop-opacity="0" /></linearGradient>
        <mask id="m-in" maskContentUnits="objectBoundingBox"><rect width="1" height="1" fill="url(#osa-in)" /></mask>
        <mask id="m-out" maskContentUnits="objectBoundingBox"><rect width="1" height="1" fill="url(#osa-out)" /></mask>
      </defs>
      <g class="osa-ms">
        {milestones.map((m) => <g data-od={m.od} data-do={m.do}><title>{m.nazev} ({m.od === m.do ? m.od : `${m.od}–${m.do}`}): {m.popis}</title>
          <rect x={L.x(m.od)} y="0" width={Math.max(3, L.x(m.do + 1) - L.x(m.od))} height={L.height} /><text x={L.x(m.od) + 3} y="12">{m.nazev}</text></g>)}
      </g>
      <g class="osa-axis">{decades.map((y) => <g data-y={y}><line x1={L.x(y)} x2={L.x(y)} y1="16" y2={L.height} /><text x={L.x(y)} y="28">{y}</text></g>)}</g>
      <g class="osa-heads">{L.heads.map((h) => <text x="6" y={h.y}>{h.label}</text>)}</g>
      {rows.map((r) => { const B = bar(r, L.x); return (
        <a href={`/osoba/${r.id}/`} class="osa-row" data-id={r.id} data-line={r.line} data-gen={r.gen ?? ''} data-place={r.place ?? ''} data-name={r.name} data-line-name={r.lineName} data-line-order={r.lineOrder} data-alive={r.alive ? '1' : ''}
          data-b={JSON.stringify(r.b)} data-d={JSON.stringify(r.d ?? null)} transform={`translate(0 ${L.pos[r.id]})`} style={`--c:var(--line-${r.line})`}>
          <title>{title(r)}</title>
          {B.in && <rect class="whisk" mask="url(#m-in)" x={B.in[0]} y="12" width={B.in[1] - B.in[0]} height="9" />}
          <rect class="solid" x={B.solid[0]} y="12" width={B.solid[1] - B.solid[0]} height="9" rx="2" />
          {B.out && <rect class={`whisk${B.open ? ' open' : ''}`} mask="url(#m-out)" x={B.out[0]} y="12" width={B.out[1] - B.out[0]} height="9" />}
          <text x={(B.in ?? B.solid)[0]} y="9">{r.name} <tspan class="yrs">{r.years}</tspan></text>
        </a>); })}
    </svg>
  </div>
  <p class="small muted osa-legend"><span><i class="lg solid"></i>roky doložené</span><span><i class="lg whisk"></i>rok jen přibližně (odhad nebo dopočteno z dětí)</span><span><i class="lg open"></i>úmrtí neznámé</span>
    {missing > 0 && <span>{missing} osob na ose chybí, protože o jejich letech nevíme vůbec nic.</span>}</p>
</Base>

<script>
  import { layout, bar } from '../lib/osa.js';
  const svg = document.querySelector<SVGSVGElement>('[data-osa]')!;
  const ctrl = document.querySelector('[data-osa-ctrl]')!;
  const scroller = document.querySelector<HTMLElement>('[data-osa-scroll]')!;
  const from = Number(svg.dataset.from);
  const els = [...svg.querySelectorAll<SVGAElement>('.osa-row')];
  const rows = els.map((el) => { const d = el.dataset; return { el, id: d.id!, name: d.name!, line: d.line!, lineName: d.lineName!, lineOrder: Number(d.lineOrder), gen: d.gen ? Number(d.gen) : null, place: d.place || null, alive: !!d.alive, b: JSON.parse(d.b!), d: JSON.parse(d.d!) }; });
  const mobile = matchMedia('(max-width: 720px)');
  const params = new URLSearchParams(location.search);
  const state = { sort: params.get('razeni') || 'rod', pxy: mobile.matches ? 2.5 : 6, hidden: new Set<string>() };
  const set = (el: Element, a: Record<string, number | string>) => Object.entries(a).forEach(([k, v]) => el.setAttribute(k, String(v)));
  function render() {
    const L = layout(rows, { from, ...state });
    set(svg, { width: L.width, height: L.height, viewBox: `0 0 ${L.width} ${L.height}` });
    svg.querySelectorAll<SVGGElement>('.osa-ms g').forEach((g) => { const od = Number(g.dataset.od), d = Number(g.dataset.do);
      set(g.querySelector('rect')!, { x: L.x(od), width: Math.max(3, L.x(d + 1) - L.x(od)), height: L.height }); set(g.querySelector('text')!, { x: L.x(od) + 3 }); });
    svg.querySelectorAll<SVGGElement>('.osa-axis g').forEach((g) => { const x = L.x(Number(g.dataset.y)); set(g.querySelector('line')!, { x1: x, x2: x, y2: L.height }); set(g.querySelector('text')!, { x }); });
    svg.querySelector('.osa-heads')!.innerHTML = L.heads.map((h) => `<text x="6" y="${h.y}"></text>`).join('');
    svg.querySelectorAll('.osa-heads text').forEach((t, i) => (t.textContent = L.heads[i].label));
    for (const r of rows) {
      const y = L.pos[r.id];
      r.el.style.display = y == null ? 'none' : '';
      if (y == null) continue;
      r.el.setAttribute('transform', `translate(0 ${y})`);
      const B = bar(r, L.x), [w1, s, w2] = [r.el.querySelector('.whisk[mask="url(#m-in)"]'), r.el.querySelector('.solid')!, r.el.querySelector('.whisk[mask="url(#m-out)"]')];
      if (B.in && w1) set(w1, { x: B.in[0], width: B.in[1] - B.in[0] });
      set(s, { x: B.solid[0], width: B.solid[1] - B.solid[0] });
      if (B.out && w2) set(w2, { x: B.out[0], width: B.out[1] - B.out[0] });
      set(r.el.querySelector('text')!, { x: (B.in ?? B.solid)[0] });
    }
  }
  ctrl.addEventListener('change', (e) => {
    const t = e.target as HTMLInputElement;
    if (t.name === 'sort') state.sort = t.value;
    if (t.name === 'line') t.checked ? state.hidden.delete(t.value) : state.hidden.add(t.value);
    render();
  });
  ctrl.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) => b.addEventListener('click', () => {
    const mid = (scroller.scrollLeft + scroller.clientWidth / 2) / state.pxy;
    state.pxy = Math.min(16, Math.max(1.5, state.pxy * (b.dataset.zoom === '1' ? 1.4 : 1 / 1.4)));
    render();
    scroller.scrollLeft = mid * state.pxy - scroller.clientWidth / 2;
  }));
  (ctrl.querySelector('select') as HTMLSelectElement).value = state.sort;
  render();
  const focus = params.get('o') && rows.find((r) => r.id === params.get('o'));
  if (!focus) {
    const ty = (e: Element) => Number(e.getAttribute('transform')!.match(/translate\(0 ([\d.]+)\)/)![1]);
    const first = [...els].sort((a, b) => ty(a) - ty(b))[0].getBBox().x;
    scroller.scrollLeft = Math.max(0, first - 20);
  }
  if (focus) {
    svg.classList.add('has-focus');
    focus.el.classList.add('focus');
    state.hidden.delete(focus.line);
    const box = focus.el.getBBox();
    const y = Number(focus.el.getAttribute('transform')!.match(/translate\(0 ([\d.]+)\)/)![1]);
    scroller.scrollLeft = Math.max(0, box.x - 60);
    scroller.scrollTop = Math.max(0, y - scroller.clientHeight / 3);
    window.scrollTo({ top: (ctrl as HTMLElement).getBoundingClientRect().top + window.scrollY - 80 });
  }
</script>
