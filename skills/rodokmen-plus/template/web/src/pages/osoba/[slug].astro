---
import Base from '../../layouts/Base.astro';
import PersonLink from '../../components/PersonLink.astro';
import Record from '../../components/Record.astro';
import Pedigree from '../../components/Pedigree.astro';
import MobileTree from '../../components/MobileTree.astro';
import RecLinks from '../../components/RecLinks.astro';
import Mentions from '../../components/Mentions.astro';
import ViewSwitch from '../../components/ViewSwitch.astro';
import { issues, people, families, lineByK, records, dateKey, href, statusClass, houses, houseTitle, span, birthOf, factWithAge } from '../../lib/data.js';

export function getStaticPaths() {
  return Object.keys(people).map((slug) => ({ params: { slug } }));
}
const p = people[Astro.params.slug];
const line = p.line ? lineByK[p.line] : null;
const recs = [...new Set(p.records)].filter((r) => records[r]).sort((a, b) => dateKey(records[a].date) - dateKey(records[b].date));
const path = [...p.path].reverse().filter(Boolean);
const lineSlug = p.lineSlug ?? null;
const open = issues.filter((i) => i.people?.includes(p.slug) && !i.text.startsWith('Vyřešeno'));
const onAxis = p.birth && (p.death || p.alive);
// rozšiřující bod projektu (po vzoru xsigik/rodokmen-skill@318a965): komponenty web/src/local/osoba/*.astro dostanou `p`;
// p.extra = volná pole osoby z data/osoby.py (extra=dict(…)); klíče s „_“ na začátku jsou jen pro lokální komponenty
const doplnky = Object.entries(import.meta.glob('../../local/osoba/*.astro', { eager: true })).sort(([a], [b]) => a.localeCompare(b)).map(([, m]) => m.default);
const extra = Object.entries(p.extra ?? {}).filter(([k, v]) => !k.startsWith('_') && v !== null && v !== '');
const fmt = (v) => Array.isArray(v) ? v.join(', ') : typeof v === 'object' ? JSON.stringify(v) : String(v);
---
<Base title={p.name} description={`${p.name} ${p.years} – ${p.rel}`}>
  <div class="crumbs">
    {path.map((s, i) => <>{i > 0 && <span>→</span>}{s === p.slug ? <span>{people[s].name}</span> : <a href={href.person(s)}>{people[s].name.split(' ')[0]} {people[s].years}</a>}</>)}
  </div>
  <div class="person-card" style={lineSlug ? `--c:var(--line-${lineSlug})` : undefined}>
    {p.portrait ? (
      <figure class="portrait">
        <a href={`/${p.portrait.full ? 'zdroje' : 'img'}/${encodeURIComponent(p.portrait.img)}.jpg`} target="_blank" rel="noopener" aria-label={`Otevřít portrét: ${p.name} (nová karta)`}>
          <img src={`/img/${encodeURIComponent(p.portrait.img)}.jpg`} alt={`Portrét: ${p.name}`} decoding="async" />
        </a>
        {p.portrait.caption && <figcaption>{p.portrait.caption}</figcaption>}
      </figure>
    ) : <span class="initial" aria-hidden="true">{p.name.replace(/^\(/, '').charAt(0)}</span>}
    <div>
      <h1>{p.name}</h1>
      {p.years && <div class="big-years">{p.years}</div>}
      <div class="chips">
        <span class="chip">{p.rel}</span>
        {line && <a class="chip" href={href.line(line.slug)}><span class="dot" style={`background:${line.color}`}></span>rod {line.name}</a>}
        <span class={`chip ${statusClass(p.st)}`}>{p.status}</span>
      </div>
    </div>
    <div class="views">
      <ViewSwitch slug={p.slug} />
      {p.k && <a class="chip" href={`/vejir/?o=${p.slug}`}>ve vějíři →</a>}
      <a class="chip" href={`/reka/?o=${p.slug}`}>Řeka kolem této osoby →</a>
      {onAxis && <a class="chip" href={`/osa/?o=${p.slug}`}>ukázat na ose →</a>}
    </div>
  </div>

  <div class="person-cols">
  <div class="person-life">
  {p.also.length > 0 && (
    <p class="note">V rodokmenu dvakrát – pedigree collapse: je předkem přes {p.children.map((c, i) => <>{i > 0 && ' i přes '}<PersonLink slug={c} /></>)}.
      Podruhé jako {p.also.map((a) => a.rel).join(', ')}.</p>
  )}
  <h2 class="life-h">Život</h2>
  {p.facts.length > 0 && <ul class="facts">{p.facts.map((f) => <li>{factWithAge(f, birthOf(p))}</li>)}</ul>}
  {p.note && <p class="note">{p.note}</p>}
  {extra.length > 0 && (
    <table class="extra">{extra.map(([k, v]) => <tr><th scope="row">{k}</th><td>{fmt(v)}</td></tr>)}</table>
  )}
  {doplnky.map((Doplnek) => <Doplnek p={p} />)}

  {p.homes.length > 0 && (
    <>
      <h2>Kde {p.sex === 'F' ? 'žila' : 'žil'}</h2>
      <ul class="homes">
        {p.homes.map((b) => (
          <li>
            <span class="home-years">{span(b.since, b.until) || '—'}</span>
            <span>{b.house ? <a href={href.house(b.house)}>{houseTitle(houses[b.house])}</a> : <>{b.obecSlug ? <a href={href.place(b.obecSlug)}>{b.obec}</a> : b.obec} čp. {b.cp}</>}
              {b.role && <span class="muted"> – {b.role}</span>}
              {b.house && !houses[b.house].processed && <span class="small muted"> (dějiny domu zatím nezpracované)</span>}
              <RecLinks ids={b.records} /></span>
          </li>
        ))}
      </ul>
    </>
  )}

  {p.side.length > 0 && (
    <>
      <h2>Příbuzní mimo přímou linii</h2>
      <div class="grid2">
        {p.side.map((s) => (
          <div class="card"><h3>{s.name}</h3><p class="small">{s.text}</p>
            {s.records.length > 0 && <p class="small">Zápisy: {s.records.filter((r) => records[r]).map((r, i) => <>{i > 0 && ' · '}<a href={href.record(r)}>{records[r].date}</a></>)}</p>}
          </div>
        ))}
      </div>
    </>
  )}


  {open.length > 0 && (
    <>
      <h2>Co o {p.sex === 'F' ? 'ní' : 'něm'} hledáme</h2>
      {open.map((i) => <div class="card"><h3>{i.title}</h3><p class="small">{i.text}</p></div>)}
      <p class="small"><a href="/hledame/">Všechny otevřené otázky →</a></p>
    </>
  )}

  <Mentions items={p.mentions} />

  {p.docs.length > 0 && (
    <>
      <h2>Rodinné dokumenty</h2>
      <div class="docs">{p.docs.map((d) => <figure><a href={`/img/${d.img}.jpg`} target="_blank" rel="noopener"><img src={`/img/${d.img}.jpg`} alt={d.caption} loading="lazy" /></a><figcaption>{d.caption}</figcaption></figure>)}</div>
    </>
  )}

  </div>
  <aside class="person-family">
  <h2>Rodina</h2>
  <div>
    <div class="card">
      <h3>Rodiče</h3>
      <p>Otec: {p.father ? <PersonLink slug={p.father} /> : <span class="muted">{p.fatherUnknown ? 'neuveden (nemanželské dítě)' : 'zatím neznámý'}</span>}<br />
        Matka: {p.mother ? <PersonLink slug={p.mother} /> : <span class="muted">zatím neznámá</span>}</p>
      {p.family && <p class="small"><a href={href.family(p.family)}>Rodina, ze které pochází →</a></p>}
    </div>
    {(p.spouses.length > 0 || p.children.length > 0) && (
      <div class="card">
        <h3>{p.sex === 'M' ? (p.spouses.length > 1 ? 'Manželky' : 'Manželka') : (p.spouses.length > 1 ? 'Manželé' : 'Manžel')} a {p.children.length > 1 ? 'děti' : 'dítě'}</h3>
        <p>{p.spouses.length ? p.spouses.map((s, i) => <>{i > 0 && ', '}<PersonLink slug={s} /></>) : <span class="muted">{p.sex === 'F' && p.child && people[p.child]?.fatherUnknown ? 'otec dítěte neuveden' : 'neznámý partner'}</span>}
          {p.children.length > 0 && <><br />{p.children.length > 1 ? 'Děti' : 'Dítě'}: {p.children.map((c, i) => <>{i > 0 && ', '}<PersonLink slug={c} />{c === p.child && <span class="small muted"> (v linii)</span>}</>)}</>}</p>
        {p.ownFamily && <p class="small"><a href={href.family(p.ownFamily)}>Jejich rodina →</a></p>}
      </div>
    )}
  </div>
  {p.siblings.length > 0 && (
    <p>Sourozenci: {p.siblings.map((s, i) => <>{i > 0 && ', '}<PersonLink slug={s} /></>)}</p>
  )}

  </aside>
  </div>

  <h2>Předci</h2>
  <div class="only-desktop"><Pedigree slug={p.slug} /></div>
  <div class="only-mobile"><MobileTree slug={p.slug} /></div>

  <details id="zapisy" class="sources" open={recs.length <= 3}>
  <summary>Zápisy z matrik ({recs.length})</summary>
  {recs.length ? <div class="recs">{recs.map((r) => <Record id={r} showPeople exclude={p.slug} />)}</div>
    : <p class="muted">K této osobě zatím nemáme vlastní matriční zápis – údaje pocházejí ze zápisů jejích dětí{p.st === 'fam' ? ' nebo od rodiny' : ''}.</p>}
  </details>
</Base>
