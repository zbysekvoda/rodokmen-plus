---
import Base from '../../layouts/Base.astro';
import StoryDocs from '../../components/StoryDocs.astro';
import { config, lineByK, href, houseList, houseTitle } from '../../lib/data.js';
const house = houseList.find((h) => h.slug === config.pribehDum);
import { Content, frontmatter } from '../../generated/pribeh_domu.md';
---
<Base title={frontmatter.title}>
  <p class="crumbs">{house && <><a href={href.house(house.slug)}>{houseTitle(house)}</a> · </>}<a href="/pribehy/">příběh rodu</a> · <a href="/zajimavosti/">další zajímavosti</a></p>
  <h1>{frontmatter.title}</h1>
  {frontmatter.lead && <p class="lead">{frontmatter.lead}</p>}
  <div class="prose"><Content /></div>

  <div class="next-step">
    <p><strong>Chcete víc?</strong> Další objevy z rodokmenu najdete v zajímavostech, podrobnosti o domě – držitele, obyvatele, staré mapy – na jeho stránce.</p>
    {house && <a class="btn" href={href.house(house.slug)}>Dějiny domu →</a>} <a class="btn" href="/zajimavosti/">Zajímavosti →</a>
  </div>

  <StoryDocs story="pribeh-domu" />
</Base>
