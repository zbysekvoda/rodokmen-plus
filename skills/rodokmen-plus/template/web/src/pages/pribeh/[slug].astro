---
// Stránka jednoho příběhu: velké příběhy z data/web.json „pribehy“ ([{slug, titulek, soubor}]) i krátké příběhy –
// každá zajímavost z data/zajimavosti*.md (frontmatter kratky: true). Export je zapíše do src/generated/pribehy/<slug>.md.
import Base from '../../layouts/Base.astro';
import StoryDocs from '../../components/StoryDocs.astro';
import StoryTree from '../../components/StoryTree.astro';
import HouseLink from '../../components/HouseLink.astro';
import { lines, config, people, records, href } from '../../lib/data.js';
const files = import.meta.glob('../../generated/pribehy/*.md', { eager: true });
export function getStaticPaths() {
  const all = import.meta.glob('../../generated/pribehy/*.md', { eager: true });
  return Object.keys(all).map((f) => ({ params: { slug: f.split('/').pop().replace(/\.md$/, '') } }));
}
const { slug } = Astro.params;
const { Content, frontmatter, rawContent } = files[`../../generated/pribehy/${slug}.md`];
// rod z frontmatteru (rod: slug rodu) – odkaz na stránku rodu
const line = frontmatter.rod ? lines[frontmatter.rod] : null;
// krátký příběh: rody podle zmíněných osob, předchozí / další v pořadí ze souboru
const short = config.kratkePribehy ?? [];
const i = short.findIndex((s) => s.slug === slug);
const me = i >= 0 ? short[i] : null;
const prev = me && i > 0 ? short[i - 1] : null;
const next = me && i < short.length - 1 ? short[i + 1] : null;
const myLines = (me?.rody ?? []).map((r) => lines[r]).filter(Boolean);
// zmínění lidé, zápisy a domy (export: osoby / zdroje / domy z odkazů v textu); náhledy nejvýš 4 zápisů, zbytek odkazem
const myPeople = (me?.osoby ?? []).map((s) => people[s]).filter(Boolean);
const myRecs = (me?.zdroje ?? []).map((k) => records[k]).filter(Boolean);
const shownRecs = myRecs.slice(0, 4);
const moreRecs = myRecs.slice(4);
const myHouses = me?.domy ?? [];
const initials = (n) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('');
---
<Base title={frontmatter.title} description={me?.lead || frontmatter.lead || undefined}>
  {me ? (
    <p class="crumbs"><a href="/pribehy/">příběhy</a> · <a href="/pribehy/#kratke">krátké příběhy</a>{me.skupina && <> · {me.skupina}</>}</p>
  ) : (
    <p class="crumbs"><a href="/pribehy/">příběhy</a>{line && <> · <a href={`/rod/${line.slug}/`}>{line.name}</a></>}</p>
  )}
  <h1>{frontmatter.title}</h1>
  {frontmatter.lead && <p class="lead">{frontmatter.lead}</p>}
  <div class="prose"><Content /></div>
  <StoryTree text={rawContent()} />

  {me ? (
    <>
      {myPeople.length > 0 && (
        <section class="story-people">
          <h2 class="small muted">Lidé v příběhu</h2>
          <div class="story-cards">
            {myPeople.map((p) => (
              <a class="card card-link story-person" href={href.person(p.slug)}>
                <span class="ini" aria-hidden="true">{initials(p.name)}</span>
                <span><strong>{p.name}</strong>{p.years && <span class="small muted"> {p.years}</span>}</span>
              </a>
            ))}
          </div>
        </section>
      )}
      {myRecs.length > 0 && (
        <section class="story-recs">
          <h2 class="small muted">Zápisy</h2>
          <div class="story-cards">
            {shownRecs.map((r) => (
              <a class="card card-link story-rec" href={href.record(r.key)}>
                {r.img && <img src={`/img/${r.key}.jpg`} alt={`Výřez zápisu: ${r.title}`} loading="lazy" />}
                <span class="small muted">{r.kindName} {r.date}</span>
                <span class="small">{r.title}</span>
              </a>
            ))}
          </div>
          {moreRecs.length > 0 && (
            <p class="small">Další zápisy: {moreRecs.map((r, j) => <>{j > 0 && ', '}<a href={href.record(r.key)}>{r.kindName} {r.date}</a></>)}</p>
          )}
        </section>
      )}
      {myHouses.length > 0 && (
        <p class="small">Dům: {myHouses.map((h, j) => <>{j > 0 && ', '}<HouseLink slug={h} /></>)}</p>
      )}
      {myLines.length > 0 && (
        <p class="chips">{myLines.map((l) => <a class="chip" href={`/rod/${l.slug}/`}><span class="dot" style={`background:${l.color}`}></span>rod {l.name}</a>)}</p>
      )}
      <nav class="story-nav" aria-label="Další příběhy">
        {prev ? <a rel="prev" href={`/pribeh/${prev.slug}/`}><span class="small muted">← Předchozí</span>{prev.titulek}</a> : <span></span>}
        <a class="all" href="/pribehy/#kratke">Všechny příběhy</a>
        {next ? <a rel="next" href={`/pribeh/${next.slug}/`}><span class="small muted">Další →</span>{next.titulek}</a> : <span></span>}
      </nav>
    </>
  ) : (
    <div class="next-step">
      <p><strong>Chcete víc?</strong> {line ? 'Všechny osoby rodu a jejich zápisy najdete na stránce rodu, další' : 'Další'} vyprávění mezi příběhy.</p>
      {line && <a class="btn" href={`/rod/${line.slug}/`}>Rod {line.name} →</a>} <a class="btn" href="/pribehy/">Další příběhy →</a>
    </div>
  )}

  <StoryDocs story={slug} />
</Base>
<style>
  .story-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr)); gap: .6rem; margin: .4rem 0 1rem; }
  .story-person { display: flex; gap: .6rem; align-items: center; }
  .story-person .ini { flex: none; width: 2.2rem; height: 2.2rem; border-radius: 50%; display: grid; place-items: center;
    background: var(--line, #e6e0d6); font-weight: 600; font-size: .85rem; }
  .story-rec { display: flex; flex-direction: column; gap: .2rem; }
  .story-rec img { width: 100%; height: 6rem; object-fit: cover; border-radius: 4px; }
  .story-people h2, .story-recs h2 { margin: 1.4rem 0 0; font-size: .85rem; text-transform: uppercase; letter-spacing: .04em; }
</style>
