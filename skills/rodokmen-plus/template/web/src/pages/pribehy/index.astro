---
// Rozcestník příběhů: hlavní příběh (/pribeh-rodu/), příběh domu, další příběhy z web.json „pribehy“ a zajímavosti.
import Base from '../../layouts/Base.astro';
import { config } from '../../lib/data.js';
import { frontmatter as pribeh } from '../../generated/pribeh.md';
import { frontmatter as pribehDomu } from '../../generated/pribeh_domu.md';
const items = [
  ...(config.maPribeh ? [['/pribeh-rodu/', pribeh.title, pribeh.lead]] : []),
  ...(config.pribehDomuStranka ? [['/pribeh-domu/', pribehDomu.title, pribehDomu.lead]] : []),
  ...(config.pribehy ?? []).map((p) => [`/pribeh/${p.slug}/`, p.titulek, '']),
  ['/zajimavosti/', 'Zajímavosti z rodokmenu', 'Co nás při hledání nejvíc překvapilo – nejstarší předek, spojené větve, řemesla a osudy.'],
  ['/osobnosti/', 'Významné osobnosti', 'Předci, kteří vyčnívali – kněží a učitelé, starostové, vojáci, umělci, podnikatelé.'],
  ['/statistiky/', 'Rodokmen v číslech', 'Řemesla, věk při svatbě, délka života, nejčastější jména a odkud to víme.'],
];
---
<Base title="Příběhy" wide>
  <h1>Příběhy</h1>
  <p class="lead">Vyprávění o rodině a domech, sepsaná z matrik a dalších pramenů.</p>
  <div class="house-list">
    {items.map(([url, title, lead]) => (
      <a class="card card-link" href={url}>
        <h3>{title}</h3>
        {lead && <p class="small">{lead}</p>}
        <span class="more-link">Číst</span>
      </a>
    ))}
  </div>
</Base>
