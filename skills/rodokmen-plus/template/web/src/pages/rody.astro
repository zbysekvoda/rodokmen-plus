---
import Base from '../layouts/Base.astro';
import PersonLink from '../components/PersonLink.astro';
import SurnameNet from '../components/SurnameNet.astro';
import { lines, people, href, linesTitle } from '../lib/data.js';
const list = Object.values(lines).sort((a, b) => a.k - b.k);
// strana otce/matky: v generaci g má otcova polovina čísla 2^g … 1,5·2^g − 1
const poOtci = (k) => k < 3 * 2 ** (Math.floor(Math.log2(k)) - 1);
---
<Base title="Rody">
  <h1>{linesTitle(list.length)}</h1>
  <p class="lead">Rodokmen se větví podle předků v jedné generaci (obvykle pradědečků a prababiček). Každý rod je jedna z těchto větví se všemi svými předky.</p>
  {list.length === 0 && <p>Rody se ukážou, až budou v rodokmenu založené (RODY v data/osoby.py).</p>}
  <h2>Po otci</h2>
  <div class="grid2">
    {list.filter((l) => poOtci(l.k)).map((l) => (
      <a class="card line-card card-link" style={`--c:${l.color}`} href={href.line(l.slug)}>
        <h3>{l.name}</h3>
        <p class="small">{l.desc}</p>
        <p class="small muted">{l.people.length} předků · začíná u {people[l.root].name}</p>
      </a>
    ))}
  </div>
  <h2>Po matce</h2>
  <div class="grid2">
    {list.filter((l) => !poOtci(l.k)).map((l) => (
      <a class="card line-card card-link" style={`--c:${l.color}`} href={href.line(l.slug)}>
        <h3>{l.name}</h3>
        <p class="small">{l.desc}</p>
        <p class="small muted">{l.people.length} předků · začíná u {people[l.root].name}</p>
      </a>
    ))}
  </div>
  <SurnameNet />
</Base>
