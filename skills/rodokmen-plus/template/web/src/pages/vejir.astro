---
import Base from '../layouts/Base.astro';
import ViewSwitch from '../components/ViewSwitch.astro';
import fan from '../generated/fan.svg?raw';
import { people, roots } from '../lib/data.js';
// vějíř pro každý kořen (KORENY): fan.svg = výchozí, fan-<klíč>.svg = ostatní; volba přes ?o=<id osoby>
const extra = import.meta.glob('../generated/fan-*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const fans = roots.map((r, i) => ({ ...r, svg: i === 0 ? fan : extra[`../generated/fan-${r.key}.svg`] })).filter((f) => f.svg);
const names = [...new Set(Object.values(people).filter((p) => p.k > 1).map((p) => p.name))].sort((a, b) => a.localeCompare(b, 'cs'));
---
<Base title="Vějíř předků" full>
  <div class="fan-bar">
    <ViewSwitch current="vejir" />
    <strong>Vějíř předků</strong>
    {fans.length > 1 && (
      <label class="small">Kořen
        <select class="fan-root" aria-label="Vybrat kořen">{fans.map((f) => <option value={f.id}>{f.name}</option>)}</select>
      </label>
    )}
    <form class="fan-search" autocomplete="off">
      <input list="fan-names" placeholder="Najít předka…" aria-label="Najít předka" />
      <datalist id="fan-names">{names.map((n) => <option value={n} />)}</datalist>
      <button type="submit">Najít</button>
    </form>
    <span class="fan-btns">
      <button type="button" data-pz="in" aria-label="Přiblížit">+</button>
      <button type="button" data-pz="out" aria-label="Oddálit">−</button>
      <button type="button" data-pz="reset">Zpět na celý vějíř</button>
    </span>
    <span class="small muted fan-hint">Kolečkem myši nebo dvěma prsty přibližujte, tažením posouvejte, šrafovaná pole „↺ viz č.“ = předek, který se v rodokmenu opakuje, klepnutím na jméno otevřete stránku. Celou rodinu shora dolů ukazuje <a href="/strom-cely/">celý strom</a>.</span>
  </div>
  {fans.map((f, i) => <div class="fan-stage" data-root={f.id} hidden={i > 0} set:html={f.svg} />)}

  <script>
    import { panZoom, bindButtons } from '../lib/panzoom.js';
    const stages = [...document.querySelectorAll<HTMLElement>('.fan-stage')];
    const want = new URLSearchParams(location.search).get('o');
    const stage = stages.find((s) => s.dataset.root === want) ?? stages[0];
    stages.forEach((s) => (s.hidden = s !== stage));
    const rootPick = document.querySelector<HTMLSelectElement>('.fan-root');
    if (rootPick) {
      rootPick.value = stage.dataset.root!;
      rootPick.addEventListener('change', () => { location.search = `?o=${encodeURIComponent(rootPick.value)}`; });
    }
    // Plynulý posun a přibližování (kolečko, touchpad, pinch) přes sdílený panzoom.js – podle forků
    // jozefizso 72293c5 / hnizdiljan 17d6c16 („Vějíř: plynulý posun a přibližování“):
    // https://github.com/jozefizso/rodokmen-skill/blob/72293c54770db26e007f6fb477bd8148c2611d9b/skills/rodokmen/template/web/src/lib/fanview.ts
    const svg = stage.querySelector('svg')!;
    const pz = panZoom(stage, svg, { maxZoom: 40, minZoom: 1 / 1.2 });
    bindButtons(document.querySelector('.fan-btns')!, pz);
    // sdílený předek: najetí na značku „↺ viz č.“ zvýrazní první výskyt
    svg.querySelectorAll<SVGAElement>('.fan-links a[data-same]').forEach((a) => {
      const orig = svg.querySelector(`.fan-links a[data-k="${a.dataset.same}"]`);
      a.addEventListener('pointerenter', () => orig?.classList.add('hit'));
      a.addEventListener('pointerleave', () => orig?.classList.remove('hit'));
    });

    // search: zoom to the ancestor's segment and highlight it
    const norm = (t: string) => t.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
    document.querySelector('.fan-search')!.addEventListener('submit', (e) => {
      e.preventDefault();
      const q = norm((e.currentTarget as HTMLFormElement).querySelector('input')!.value.trim());
      if (!q) return;
      svg.querySelectorAll('.fan-links a.hit').forEach((a) => a.classList.remove('hit'));
      const hits = [...svg.querySelectorAll<SVGAElement>('.fan-links a')].filter((a) => norm(a.querySelector('title')?.textContent ?? '').includes(q));
      if (!hits.length) return;
      hits.forEach((a) => a.classList.add('hit'));
      const bb = (hits[0].lastElementChild as SVGGraphicsElement).getBBox();
      const w = Math.max(bb.width, bb.height) * 7;
      pz.focus(bb.x + bb.width / 2 - w / 2, bb.y + bb.height / 2 - w / 2, w, w);
    });
  </script>
</Base>
