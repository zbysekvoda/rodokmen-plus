---
// Zajímavosti už nejsou jedna stránka: každá má vlastní adresu /pribeh/<slug>/ (krátké příběhy).
// Stará adresa /zajimavosti/#<kotva nadpisu> přesměruje na příběh, bez kotvy na rozcestník.
import Base from '../layouts/Base.astro';
import { config } from '../lib/data.js';
const map = config.zajimavostiKotvy ?? {};
---
<Base title="Krátké příběhy">
  <h1>Krátké příběhy</h1>
  <p>Zajímavosti se přestěhovaly: každá má teď vlastní stránku mezi <a href="/pribehy/#kratke">příběhy</a>.</p>
  <script is:inline define:vars={{ map }}>
    const k = decodeURIComponent(location.hash.slice(1));
    location.replace(map[k] ? `/pribeh/${map[k]}/` : '/pribehy/#kratke');
  </script>
</Base>
